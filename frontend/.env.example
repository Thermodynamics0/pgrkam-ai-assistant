# Sample data for the jobs, courses, and profile screens.
VITE_USE_MOCK=true
# Chat uses the real backend by default. Set true only to preview a sample conversation.
VITE_USE_CHAT_MOCK=false
# Leave empty in dev (Vite proxies /api). Set to the deployed backend URL for production, e.g. https://your-api.onrender.com/api
VITE_API_URL=
# Backend port configured in server/.env (default from server/.env.example is 5001).
VITE_API_PROXY_TARGET=http://localhost:5001
