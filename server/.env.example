PORT=5001
DATABASE_URL="postgresql://<your_user>@localhost:5432/pgrkam_clean?schema=public"
JWT_SECRET="your_jwt_secret_here"

# AI_PROVIDER can be "gemini" or "external". Gemini is the default.
AI_PROVIDER=gemini
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_ATTEMPT_TIMEOUT_MS=10000
AI_TIMEOUT_MS=20000
AI_CHAT_MAX_MESSAGE_CHARS=4000
AI_CHAT_MAX_HISTORY_MESSAGES=20
AI_CHAT_MAX_HISTORY_MESSAGE_CHARS=4000
AI_CHAT_MAX_HISTORY_TOTAL_CHARS=20000
AI_CHAT_RATE_LIMIT_MAX=10
AI_CHAT_RATE_LIMIT_WINDOW_MS=60000

# Set AI_PROVIDER=external and uncomment this URL to use the team's separate AI service.
# AI_SERVICE_URL="http://localhost:5002/api/ai/chat"
